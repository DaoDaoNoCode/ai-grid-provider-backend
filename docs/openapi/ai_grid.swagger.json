          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "offset",
            "description": "Index of the first result. If not specified the default value will be zero.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "description": "Maximum number of results to be returned by the server. When not specified all\nthe results will be returned.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "filter",
            "description": "CEL over `this` (a Subscription, proto field names) and `now` (server time),\nwith cel-go's standard library plus its strings extension. Empty means all.\nEvaluated in memory before order and paging. Indexing a missing map key is\nan error (use the `in` guard), not false.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "order",
            "description": "Sort key. Empty means `id` ascending. Allowed: id, -id, priority, -priority,\nmetadata.name, -metadata.name (`-` = descending). Any other value is\nInvalidArgument. Applied after filter and before offset/limit.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Subscriptions"
        ]
      },
      "post": {
        "summary": "Creates the subscription and a managed \u003cid\u003e-policy. Full response body.",
        "operationId": "Subscriptions_Create",
