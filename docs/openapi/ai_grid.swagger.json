    "/api/v1/clusters/{object.id}": {
      "patch": {
        "operationId": "Clusters_Update",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/v1ManagedCluster"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "object.id",
            "description": "Unique identifier of the managed cluster. For hub CRs this equals metadata.name.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "object",
            "description": "Labels and annotations: the request holds the whole set of ai-grid/* keys\nand the location label, so one on the hub but left out is removed. Other\nkeys may be sent back as read; adding or changing one is InvalidArgument,\nand so is an ai-grid/latitude or ai-grid/longitude annotation that isn't\na number within -90..90 or -180..180.",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "metadata": {
                  "$ref": "#/definitions/v1Metadata"
                },
                "spec": {
                  "$ref": "#/definitions/v1ManagedClusterSpec"
                },
                "status": {
                  "$ref": "#/definitions/v1ManagedClusterStatus"
                }
              },
              "title": "Labels and annotations: the request holds the whole set of ai-grid/* keys\nand the location label, so one on the hub but left out is removed. Other\nkeys may be sent back as read; adding or changing one is InvalidArgument,\nand so is an ai-grid/latitude or ai-grid/longitude annotation that isn't\na number within -90..90 or -180..180."
            }
          },
          {
            "name": "lock",
            "description": "Lock requires object.metadata.version: without one the request is\nInvalidArgument. A non-zero version is checked against the hub's\nresourceVersion with or without lock, before the labels, so a stale one\nis Aborted whatever the request changes, even nothing.",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "Clusters"
        ]
      }
    },
