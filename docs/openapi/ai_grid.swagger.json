              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "resource_version",
            "description": "Expected version: when set (non-zero), delete fails with Aborted unless\nit equals the stored metadata.version. Zero skips the check.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "Models"
        ]
      }
    },
    "/api/v1/models/{object.id}": {
      "patch": {
        "operationId": "Models_Update",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/v1Model"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "object.id",
            "description": "Unique identifier. Equals metadata.name (DNS-1123 label).",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "object",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "metadata": {
                  "$ref": "#/definitions/v1Metadata"
                },
                "spec": {
                  "$ref": "#/definitions/v1ModelSpec"
                },
                "status": {
                  "$ref": "#/definitions/v1ModelStatus"
                }
              },
              "description": "Model is a deployable LLM inference workload on the AI Grid.\n\nIt maps to a hub LLMInferenceService (serving.kserve.io/v1alpha2) plus an\noptional ACM Placement and ManifestWorkReplicaSet that distribute the\nworkload to managed clusters, and a MaaSModelRef for catalog registration.\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
            }
          },
          {
            "name": "lock",
            "description": "When true, update fails with Aborted unless metadata.version matches.",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "Models"
        ]
      }
    },
