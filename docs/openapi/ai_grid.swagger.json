              "$ref": "#/definitions/v1ManagedCluster"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "object",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ManagedCluster"
            }
          }
        ],
        "tags": [
          "Clusters"
        ]
      }
    },
