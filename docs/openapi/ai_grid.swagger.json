    "/api/v1/subscriptions/{object.id}": {
      "patch": {
        "operationId": "Subscriptions_Update",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/v1Subscription"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "object.id",
            "description": "Unique identifier of the subscription. Equals metadata.name.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "object",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "metadata": {
                  "$ref": "#/definitions/v1Metadata"
                },
                "spec": {
                  "$ref": "#/definitions/v1SubscriptionSpec"
                },
                "status": {
                  "$ref": "#/definitions/v1SubscriptionStatus"
                }
              },
              "description": "Subscription is a MaaS entitlement that binds identity subjects to models\nwith token rate limits and a priority.\n\nIt maps to the spoke-cluster Kubernetes CR MaaSSubscription\n(apiVersion: maas.opendatahub.io/v1alpha1). It is not an OLM Subscription,\nnot an AAP license subscription, and not OSAC SERVICE_TIER_MAAS\n(\"Metal as a Service\").\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
            }
          },
          {
            "name": "lock",
            "description": "Lock enables optimistic locking against metadata.version.",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "Subscriptions"
        ]
      }
    },
