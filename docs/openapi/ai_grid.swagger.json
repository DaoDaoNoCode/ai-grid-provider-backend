      "properties": {
        "type": {
          "type": "string",
          "description": "Condition type as defined by the owning controller."
        },
        "status": {
          "$ref": "#/definitions/v1ConditionStatus",
          "description": "Whether the object is in the condition."
        },
        "last_transition_time": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the condition changed from one status to another."
        },
        "reason": {
          "type": "string",
          "description": "Machine-readable reason in CamelCase, when the controller provides one."
        },
        "message": {
          "type": "string",
          "description": "Human-readable detail for debugging."
        },
        "observed_generation": {
          "type": "string",
          "format": "int64",
          "description": "Generation of the object the condition was computed for; zero when unknown."
        }
      },
      "description": "One entry of a Kubernetes-style status.conditions list."
    },
    "v1ConditionStatus": {
      "type": "string",
      "enum": [
        "CONDITION_STATUS_UNSPECIFIED",
        "CONDITION_STATUS_TRUE",
        "CONDITION_STATUS_FALSE"
      ],
      "default": "CONDITION_STATUS_UNSPECIFIED",
      "description": "Status of a condition. Kubernetes `Unknown` is reported as UNSPECIFIED.\n\n - CONDITION_STATUS_UNSPECIFIED: The system cannot decide whether the object is in the condition.\n - CONDITION_STATUS_TRUE: The object is in the condition.\n - CONDITION_STATUS_FALSE: The object is not in the condition."
    },
    "v1GuardrailAttachment": {
      "type": "object",
      "properties": {
        "ref_name": {
          "type": "string",
          "description": "Name of the AIGuardrail in the tenant namespace."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Selected check names; empty means all checks in the policy."
        }
      },
      "description": "GuardrailAttachment attaches an AIGuardrail policy by name."
    },
    "v1ManagedCluster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the managed cluster. For hub CRs this equals metadata.name."
        },
        "metadata": {
          "$ref": "#/definitions/v1Metadata"
        },
        "spec": {
          "$ref": "#/definitions/v1ManagedClusterSpec"
        },
        "status": {
          "$ref": "#/definitions/v1ManagedClusterStatus"
        }
      },
      "description": "Hub-side ACM/OCM ManagedCluster inventory object.\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
    },
    "v1ManagedClusterSpec": {
      "type": "object",
      "properties": {
        "hub_accepts_client": {
          "type": "boolean",
          "description": "Whether the hub accepts the spoke cluster client."
        }
      },
      "description": "Desired state of a hub ManagedCluster."
    },
    "v1ManagedClusterStatus": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "True when the ManagedCluster Available condition is True."
        },
        "joined": {
          "type": "boolean",
          "description": "True when the ManagedCluster Joined condition is True."
        },
        "available_condition": {
          "type": "string",
          "description": "Raw Available condition status (\"True\", \"False\", \"Unknown\", …). Empty when absent.\nUsed by the Clusters presentation layer to derive Ready/Offline/Unknown."
        },
        "provisioning": {
          "type": "string",
          "description": "AI Grid provisioning, from the cluster's compliance with the hub's\nai-grid-ready Policy (by default ai-grid-policies/ai-grid-ready):\n\"Compliant\" (provisioned), \"NonCompliant\", or \"Pending\" (placed, no\nresult yet). Empty when the Policy doesn't cover the cluster, for\nexample because it isn't labelled ai-grid/enabled=true, or when the\nPolicy can't be read."
        }
      },
      "description": "Observed state of a hub ManagedCluster."
    },
    "v1Metadata": {
      "type": "object",
      "properties": {
        "creation_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time of creation of the object."
        },
        "deletion_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time of deletion of the object."
        },
        "creator": {
          "type": "string",
          "description": "Creator contains the identifier of the user or group that created the object."
        },
        "tenant": {
          "type": "string",
          "description": "Tenant contains the identifier of the tenant that the object belongs to."
        },
        "name": {
          "type": "string",
          "description": "Mandatory, immutable, and unique within scope. Must be a valid RFC 1123 DNS label."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels contains key-value pairs for organizing and selecting objects."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations contains arbitrary metadata for objects."
        },
        "version": {
          "type": "integer",
          "format": "int32",
          "description": "Version is a numeric field that is automatically incremented with every change to the object."
        }
      },
      "description": "Metadata common to all kinds of objects."
    },
    "v1ModelRegistration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "Pending, Ready, Unhealthy, Failed, or Invalid."
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint when Ready; empty otherwise."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Condition"
          }
        }
      },
      "description": "ModelRegistration is a MaaSModelRef's catalog status for a referenced model."
    },
    "v1ResourceRefStatus": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "description": "ResourceRefStatus is the state of one object a MaaS resource references or generates."
    },
    "v1Subscription": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the subscription. Equals metadata.name."
        },
        "metadata": {
          "$ref": "#/definitions/v1Metadata"
        },
        "spec": {
          "$ref": "#/definitions/v1SubscriptionSpec"
        },
        "status": {
          "$ref": "#/definitions/v1SubscriptionStatus"
        }
      },
      "description": "Subscription is a MaaS entitlement that binds identity subjects to models\nwith token rate limits and a priority.\n\nIt maps to the spoke-cluster Kubernetes CR MaaSSubscription\n(apiVersion: maas.opendatahub.io/v1alpha1). It is not an OLM Subscription,\nnot an AAP license subscription, and not OSAC SERVICE_TIER_MAAS\n(\"Metal as a Service\").\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
    },
    "v1SubscriptionModelRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Model name (DNS-1123 label)."
        },
        "namespace": {
          "type": "string",
          "description": "Model namespace. Empty means the platform default model namespace."
        },
        "token_rate_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TokenRateLimit"
          },
          "description": "Token rate limits for this model. Required unless unlimited is true.\nMust be empty when unlimited is true."
        },
        "unlimited": {
          "type": "boolean",
          "description": "Access without a token budget. Mutually exclusive with token_rate_limits."
        },
        "billing_rate": {
          "$ref": "#/definitions/v1BillingRate",
          "description": "Cost per token, when set."
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GuardrailAttachment"
          },
          "description": "Guardrails for this model within the subscription."
        },
        "display_name": {
          "type": "string",
          "description": "Output enrichment from MaaSModelRef annotations. Ignored on write."
        },
        "description": {
          "type": "string",
          "description": "Output enrichment from MaaSModelRef annotations. Ignored on write."
        }
      },
      "description": "SubscriptionModelRef references a model and optional token rate limits."
    },
    "v1SubscriptionOrganization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Organization identifier. Non-empty; immutable once set."
        }
      },
      "description": "SubscriptionOrganization identifies the organization that administers a subscription."
    },
    "v1SubscriptionOwner": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IdP / Kubernetes group names."
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User names (for example service accounts)."
        }
      },
      "description": "SubscriptionOwner names the groups and users that own the entitlement."
    },
    "v1SubscriptionSpec": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/definitions/v1SubscriptionOwner",
          "description": "Identity subjects entitled by this subscription."
        },
        "model_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SubscriptionModelRef"
          },
          "description": "Models this subscription applies to, with optional per-model rate limits."
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "Relative priority among subscriptions (higher wins when policies conflict)."
        },
        "organization": {
          "$ref": "#/definitions/v1SubscriptionOrganization",
          "description": "Stable organization association. May be set once; then immutable."
        },
        "token_metadata": {
          "$ref": "#/definitions/v1TokenMetadata",
          "description": "Metadata for token attribution and metering."
        },
        "inference_priority": {
          "type": "integer",
          "format": "int32",
          "description": "Scheduling priority for inference under this subscription. Distinct from\npriority. When unset, no InferenceObjective is created."
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GuardrailAttachment"
          },
          "description": "Guardrail policies attached to every model accessed through this subscription."
        }
      },
      "description": "Desired state of a MaaS Subscription."
    },
    "v1SubscriptionStatus": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "description": "Controller-reported phase (for example \"Active\"). Empty until reconciled."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Condition"
          },
          "description": "Controller conditions (Ready, SpecPriorityDuplicate, ...)."
        },
        "model_ref_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ResourceRefStatus"
          },
          "description": "Per referenced model reconciliation status."
        },
        "token_rate_limit_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TokenRateLimitStatus"
          },
          "description": "Per generated TokenRateLimitPolicy status."
        }
      },
      "description": "Observed state of a MaaS Subscription."
    },
    "v1SubscriptionsCreateResponse": {
      "type": "object",
