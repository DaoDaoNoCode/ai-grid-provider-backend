          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "offset",
            "description": "Index of the first result. Default zero.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "description": "Maximum number of results. Omitted means all; zero means count only;\nnegative is InvalidArgument.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "filter",
            "description": "CEL over `this` (a Model, proto field names) and `now` (server time),\nwith cel-go's standard library plus its strings extension. Empty means all.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "order",
            "description": "Sort key. Empty means `id` ascending. Allowed: id, -id, metadata.name,\n-metadata.name. Any other value is InvalidArgument.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Models"
        ]
      },
      "post": {
        "summary": "Creates (= deploys) a model: LLMInferenceService, optional Placement +\nManifestWorkReplicaSet, and MaaSModelRef.",
        "operationId": "Models_Create",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/v1Model"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "object",
            "description": "id / metadata.name and spec.model.uri are required. status is ignored.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1Model"
            }
          }
        ],
        "tags": [
          "Models"
        ]
      }
    },
    "/api/v1/models/{id}": {
      "get": {
        "operationId": "Models_Get",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/v1Model"
            }
