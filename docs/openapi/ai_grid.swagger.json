    "v1Condition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Condition type as defined by the owning controller."
        },
        "status": {
          "$ref": "#/definitions/v1ConditionStatus",
          "description": "Whether the object is in the condition."
        },
        "last_transition_time": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the condition changed from one status to another."
        },
        "reason": {
          "type": "string",
          "description": "Machine-readable reason in CamelCase, when the controller provides one."
        },
        "message": {
          "type": "string",
          "description": "Human-readable detail for debugging."
        },
        "observed_generation": {
          "type": "string",
          "format": "int64",
          "description": "Generation of the object the condition was computed for; zero when unknown."
        }
      },
      "description": "One entry of a Kubernetes-style status.conditions list."
    },
    "v1ConditionStatus": {
      "type": "string",
      "enum": [
        "CONDITION_STATUS_UNSPECIFIED",
        "CONDITION_STATUS_TRUE",
        "CONDITION_STATUS_FALSE"
      ],
      "default": "CONDITION_STATUS_UNSPECIFIED",
      "description": "Status of a condition. Kubernetes `Unknown` is reported as UNSPECIFIED.\n\n - CONDITION_STATUS_UNSPECIFIED: The system cannot decide whether the object is in the condition.\n - CONDITION_STATUS_TRUE: The object is in the condition.\n - CONDITION_STATUS_FALSE: The object is not in the condition."
    },
    "v1ManagedCluster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the managed cluster. For hub CRs this equals metadata.name."
        },
        "metadata": {
          "$ref": "#/definitions/v1Metadata"
        },
        "spec": {
          "$ref": "#/definitions/v1ManagedClusterSpec"
        },
        "status": {
          "$ref": "#/definitions/v1ManagedClusterStatus"
        }
      },
      "description": "Hub-side ACM/OCM ManagedCluster inventory object.\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
    },
    "v1ManagedClusterSpec": {
      "type": "object",
      "properties": {
        "hub_accepts_client": {
          "type": "boolean",
          "description": "Whether the hub accepts the spoke cluster client."
        }
      },
      "description": "Desired state of a hub ManagedCluster."
    },
    "v1ManagedClusterStatus": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "True when the ManagedCluster Available condition is True."
        },
        "joined": {
          "type": "boolean",
          "description": "True when the ManagedCluster Joined condition is True."
        },
        "available_condition": {
          "type": "string",
          "description": "Raw Available condition status (\"True\", \"False\", \"Unknown\", …). Empty when absent.\nUsed by the Clusters presentation layer to derive Ready/Offline/Unknown."
        },
        "provisioning": {
          "type": "string",
          "description": "AI Grid provisioning, from the cluster's compliance with the hub's\nai-grid-ready Policy (by default ai-grid-policies/ai-grid-ready):\n\"Compliant\" (provisioned), \"NonCompliant\", or \"Pending\" (placed, no\nresult yet). Empty when the Policy doesn't cover the cluster, for\nexample because it isn't labelled ai-grid/enabled=true, or when the\nPolicy can't be read."
        }
      },
      "description": "Observed state of a hub ManagedCluster."
    },
    "v1Metadata": {
      "type": "object",
      "properties": {
        "creation_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time of creation of the object."
        },
        "deletion_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time of deletion of the object."
        },
        "creator": {
          "type": "string",
          "description": "Creator contains the identifier of the user or group that created the object."
        },
        "tenant": {
          "type": "string",
          "description": "Tenant contains the identifier of the tenant that the object belongs to."
        },
        "name": {
          "type": "string",
          "description": "Mandatory, immutable, and unique within scope. Must be a valid RFC 1123 DNS label."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels contains key-value pairs for organizing and selecting objects."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations contains arbitrary metadata for objects."
        },
        "version": {
          "type": "integer",
          "format": "int32",
          "description": "Version is a numeric field that is automatically incremented with every change to the object."
        }
      },
      "description": "Metadata common to all kinds of objects."
    },
    "v1Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier. Equals metadata.name (DNS-1123 label)."
        },
        "metadata": {
          "$ref": "#/definitions/v1Metadata"
        },
        "spec": {
          "$ref": "#/definitions/v1ModelSpec"
        },
        "status": {
          "$ref": "#/definitions/v1ModelStatus"
        }
      },
      "description": "Model is a deployable LLM inference workload on the AI Grid.\n\nIt maps to a hub LLMInferenceService (serving.kserve.io/v1alpha2) plus an\noptional ACM Placement and ManifestWorkReplicaSet that distribute the\nworkload to managed clusters, and a MaaSModelRef for catalog registration.\n\nThe `spec` contains the desired details and may be modified by the user.\nThe `status` contains the current status and is provided by the system."
    },
    "v1ModelContainer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "Runtime image. Empty uses the preset's."
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Resource requests (cpu, memory, nvidia.com/gpu, ...)."
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Resource limits."
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ModelEnvVar"
          },
          "description": "Environment variables (for example VLLM_ADDITIONAL_ARGS)."
        }
      },
      "description": "Main container resources and environment."
    },
    "v1ModelEnvVar": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "description": "One environment variable."
    },
    "v1ModelGatewayRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "section_name": {
          "type": "string"
        }
      },
      "description": "One gateway reference."
    },
    "v1ModelKedaTrigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "One KEDA scale trigger."
    },
    "v1ModelLabelSelector": {
      "type": "object",
      "properties": {
        "match_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "match_expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ModelLabelSelectorRequirement"
          }
        }
      },
      "description": "Label selector for Placement predicates."
    },
    "v1ModelLabelSelectorRequirement": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "description": "In, NotIn, Exists, or DoesNotExist."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "One label selector requirement."
    },
    "v1ModelPhase": {
      "type": "string",
      "enum": [
        "MODEL_PHASE_UNSPECIFIED",
        "MODEL_PHASE_PENDING",
        "MODEL_PHASE_READY",
        "MODEL_PHASE_FAILED"
      ],
      "default": "MODEL_PHASE_UNSPECIFIED",
      "description": "Derived model phase."
    },
    "v1ModelPlacement": {
      "type": "object",
      "properties": {
        "cluster_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Cluster sets to draw from. Empty means every bound set."
        },
        "label_selector": {
          "$ref": "#/definitions/v1ModelLabelSelector",
          "description": "Label selector over ManagedCluster labels."
        },
        "number_of_clusters": {
          "type": "integer",
          "format": "int32",
          "description": "Cap on selected clusters. Unset means all matching."
        }
      },
      "description": "ACM Placement desired state (subset used by the Models API)."
    },
    "v1ModelPlacementStatus": {
      "type": "object",
      "properties": {
        "number_of_selected_clusters": {
          "type": "integer",
          "format": "int32",
          "description": "Number of clusters selected."
        },
        "selected_clusters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Selected cluster names."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Condition"
          },
          "description": "Placement conditions when present."
        }
      },
      "description": "Placement observed state."
    },
    "v1ModelRollout": {
      "type": "object",
      "properties": {
        "strategy": {
          "$ref": "#/definitions/v1ModelRolloutStrategy"
        },
        "max_concurrency": {
          "type": "string",
          "description": "Progressive only: clusters at once (integer or percent like \"20%\")."
        },
        "max_failures": {
          "type": "string",
          "description": "Failed/timed-out clusters tolerated (integer or percent)."
        },
        "progress_deadline": {
          "type": "string",
          "description": "Progress deadline (e.g. \"5m\", \"None\")."
        },
        "min_success_time": {
          "type": "string",
          "description": "Hold succeeded slot before next (Progressive)."
        }
      },
      "description": "ManifestWorkReplicaSet rollout strategy."
    },
    "v1ModelRolloutStatus": {
      "type": "object",
      "properties": {
        "rolled_out": {
          "type": "boolean",
          "description": "True when PlacementRolledOut is True."
        },
        "applied": {
          "type": "boolean",
          "description": "True when ManifestworkApplied is True."
        },
        "reason": {
          "type": "string",
          "description": "Reason from the deciding condition."
        },
        "works": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ModelWorkStatus"
          },
          "description": "Per-cluster work summaries when available."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Condition"
          },
          "description": "MWRS conditions."
        }
      },
      "description": "ManifestWorkReplicaSet observed state."
    },
    "v1ModelRolloutStrategy": {
      "type": "string",
      "enum": [
        "MODEL_ROLLOUT_STRATEGY_UNSPECIFIED",
        "MODEL_ROLLOUT_STRATEGY_ALL",
        "MODEL_ROLLOUT_STRATEGY_PROGRESSIVE",
        "MODEL_ROLLOUT_STRATEGY_PROGRESSIVE_PER_GROUP"
      ],
      "default": "MODEL_ROLLOUT_STRATEGY_UNSPECIFIED",
      "description": "Rollout strategy type."
    },
    "v1ModelRouter": {
      "type": "object",
      "properties": {
        "gateway_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ModelGatewayRef"
          },
          "description": "Gateway refs. Empty uses the product default\n(openshift-ingress/openshift-ai-inference)."
        },
        "managed_route": {
          "type": "boolean",
          "description": "When true, controller manages the HTTPRoute (spec.router.route: {})."
        },
        "scheduler": {
          "type": "boolean",
          "description": "When true, inference scheduler is created (spec.router.scheduler: {})."
        }
      },
      "description": "Router configuration (spec.router)."
    },
    "v1ModelScaling": {
      "type": "object",
      "properties": {
        "min_replicas": {
          "type": "integer",
          "format": "int32",
          "description": "Minimum replicas (default 1 when unset / zero)."
        },
        "max_replicas": {
          "type": "integer",
          "format": "int32",
          "description": "Maximum replicas (required when scaling is set)."
        },
        "keda": {
          "type": "boolean",
          "description": "Whether KEDA scaling is enabled. Must be true when scaling is set."
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ModelKedaTrigger"
          },
          "description": "KEDA scale triggers (at least one required when keda is true)."
        }
      },
      "description": "KEDA-based autoscaling."
    },
    "v1ModelSource": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "Artifact URI (hf://, oci://, s3://, pvc://, http(s)://)."
        },
        "name": {
          "type": "string",
          "description": "Identifier clients send in the request model field. Defaults to id."
        }
      },
      "description": "Model artifact source (spec.model)."
    },
    "v1ModelSpec": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/definitions/v1ModelSource",
          "description": "Where the artifact comes from and the name clients send."
        },
        "replicas": {
          "type": "integer",
          "format": "int32",
          "description": "Static replica count. Mutually exclusive with scaling."
        },
        "base_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "LLMInferenceServiceConfig preset names merged under the spec."
        },
        "runtime": {
          "type": "string",
          "description": "Optional ServingRuntime / ClusterServingRuntime name."
        },
        "router": {
          "$ref": "#/definitions/v1ModelRouter",
          "description": "Router / gateway configuration."
        },
        "main": {
          "$ref": "#/definitions/v1ModelContainer",
          "description": "Main container of the workload template."
        },
        "scaling": {
          "$ref": "#/definitions/v1ModelScaling",
          "description": "Autoscaling. Mutually exclusive with replicas."
        },
        "placement": {
          "$ref": "#/definitions/v1ModelPlacement",
          "description": "Where to deploy. Unset: hub-only LLMInferenceService.\nSet: ACM Placement + ManifestWorkReplicaSet named model-\u003cid\u003e."
        },
        "rollout": {
          "$ref": "#/definitions/v1ModelRollout",
          "description": "ManifestWorkReplicaSet rollout. Only meaningful with placement; unset means All."
        }
      },
      "description": "Desired state of a Model (trimmed LLMInferenceService.spec + ACM placement)."
    },
    "v1ModelStatus": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "External URL when known."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Condition"
          },
          "description": "LLMInferenceService conditions."
        },
        "phase": {
          "$ref": "#/definitions/v1ModelPhase",
          "description": "Derived summary phase."
        },
        "reason": {
          "type": "string",
          "description": "Reason of the condition that decided phase."
        },
        "message": {
          "type": "string",
          "description": "Message of the condition that decided phase."
        },
        "placement": {
          "$ref": "#/definitions/v1ModelPlacementStatus",
          "description": "Placement status when placement is set."
        },
        "rollout": {
          "$ref": "#/definitions/v1ModelRolloutStatus",
          "description": "ManifestWorkReplicaSet status when placement is set."
        },
        "observed_generation": {
          "type": "string",
          "format": "int64",
          "description": "Observed generation from the LLMInferenceService."
        }
      },
      "description": "Observed state of a Model."
    },
    "v1ModelWorkStatus": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string"
        },
        "applied": {
          "type": "string"
        },
        "available": {
          "type": "string"
        },
        "progressing": {
          "type": "string"
        },
        "degraded": {
          "type": "string"
        }
      },
      "description": "One generated ManifestWork summary."
    },
    "v1ModelsCreateResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Model"
        }
      }
    },
    "v1ModelsDeleteResponse": {
      "type": "object"
    },
    "v1ModelsGetResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Model"
        }
      }
    },
    "v1ModelsListResponse": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "total": {
          "type": "integer",
          "format": "int32"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Model"
          }
        }
      }
    },
    "v1ModelsUpdateResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Model"
        }
      }
    },
    "v1Tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the tenant (Keycloak organization id / UUID)."
        },
        "metadata": {
          "$ref": "#/definitions/v1Metadata"
        },
        "spec": {
          "$ref": "#/definitions/v1TenantSpec"
        },
        "status": {
          "$ref": "#/definitions/v1TenantStatus"
        }
      },
      "description": "A tenant groups resources and users.\nBacked by a Keycloak Organization in the shared platform realm (KEYCLOAK_REALM),\nnot by a Keycloak realm per tenant."
    },
    "v1TenantMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Keycloak user id (UUID)."
        },
        "username": {
          "type": "string",
          "description": "Login username."
        },
        "email": {
          "type": "string",
          "description": "Email address when present on the user."
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the Keycloak user is enabled."
        }
      },
      "description": "TenantMember is a Keycloak user that belongs to the tenant's Organization.\nThis is a read projection for listing; full user management is out of scope."
    },
    "v1TenantSpec": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Email domains associated with this tenant (DNS hostnames, lowercase)."
        }
      }
    },
    "v1TenantStatus": {
      "type": "object"
    },
    "v1TenantsCreateResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Tenant"
        }
      }
    },
    "v1TenantsDeleteResponse": {
      "type": "object"
    },
    "v1TenantsGetResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Tenant"
        }
      }
    },
    "v1TenantsListMembersResponse": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "Actual number of items returned."
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of members that match (before limit)."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TenantMember"
          },
          "description": "Organization members."
        }
      }
    },
    "v1TenantsListResponse": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "Actual number of items returned."
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of items that match the search criteria."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Tenant"
          },
          "description": "List of results."
        }
      }
    },
    "v1TenantsUpdateResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Tenant"
        }
      }
    }
  }
}
