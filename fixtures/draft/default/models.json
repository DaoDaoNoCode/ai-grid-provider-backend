        "uid": "a1b2c3d4-0001-4a5b-8c6d-0e1f2a3b4c5d",
        "resourceVersion": "48700101",
        "generation": "1",
        "creationTimestamp": "2026-10-01T10:00:00Z",
        "labels": { "ai-grid/family": "tiny" },
        "annotations": {
