          "openshift.io/description": "Small CPU-only model served on the hub itself for smoke tests."
        }
      },
      "spec": {
        "model": { "uri": "hf://example-org/tiny-llm", "name": "example-org/tiny-llm" },
        "replicas": 1,
        "baseRefs": ["v3-6-0-kserve-config-llm-template-cpu"],
        "router": {
          "gatewayRefs": [{ "name": "openshift-ai-inference", "namespace": "openshift-ingress" }],
