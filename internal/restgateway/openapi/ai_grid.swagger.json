    "/api/v1/tenants/{id}:listMembers": {
      "get": {
        "summary": "ListMembers returns Keycloak users that belong to the tenant Organization.\nREST uses an AIP-136 custom method to keep the URL space flat (no nested collection).",
        "operationId": "Tenants_ListMembers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TenantsListMembersResponse"
