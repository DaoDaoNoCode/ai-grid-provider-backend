        },
        "last_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the Keycloak user is enabled."
        }
      },
      "description": "TenantMember is a Keycloak user that belongs to the tenant's Organization.\nThis is a read projection for listing; full user management is out of scope."
    },
